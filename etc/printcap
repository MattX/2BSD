# This is a sample of printcap entries used by various printers/plotters
#
# DecWriter over a tty line.
lp|B300:\
	:lp=/dev/ttyS5:\
	:sd=/usr/spool/lpd:\
	:lf=/usr/spool/lpd/errs:\
	:af=/usr/spool/lpd/acct:\
	:of=/usr/lib/lpf:\
	:if=/usr/lib/lpf:\
	:br#9600:xc#0:xs#040040:fc#077777:fs#06320:\
	:pw#132:\
	:pl#66
