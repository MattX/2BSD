set	mail = (60 /usr/spool/mail/$user)
set	notify filec
set	path = (~/bin /bin /etc /usr/bin /usr/ucb /usr/new /usr/local /usr/games .)
set	cdpath = (. /usr/src)
set	WHOAMI = `whoami`

alias	-	'fg -'
alias	m	Mail
alias	fo	'Mail -f \!*'
alias	s	suspend
alias	fg	'%\!* >& /dev/null'
alias	j	'jobs -l'
alias	h	'jobs -l'
alias	rs	'source ~/bin/reset'
alias	ls	'ls -FA'
alias	w	'w | sort'
alias	p	'egrep -i \!* ~/.phones'
