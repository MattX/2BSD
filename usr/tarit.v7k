maketape /dev/nrmt0 kernel/src/cmd/standalone/tapes/tapedir
dd if=sa/dumpimage of=/dev/nrmt0 bs=10240
tar crfb /dev/rmt0 20 tar tar.1 install.ms READ_ME bin.v7 doc man misc setup src src.v7 include tarit.v7k usenet ingres kernel job.control
dd if=/dev/nrmt0 of=/dev/null bs=20k files=8
tar tf /dev/rmt0 >/tmp/tar.list
wc -l /tmp/tar.list
rm -f /tmp/tar.list
if (test -f /arch/dist2/.ring)
then
	/usr/bin/cu `cat .ring` 1> /dev/null 2> /dev/null
else
	echo tape done | write carl `cat .tty`
fi
echo tar done
