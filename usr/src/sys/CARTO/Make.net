tcp_usrreq.o: ${I}/net/route.h ${I}/netinet/in_pcb.h
tcp_usrreq.o: ${I}/netinet/in_systm.h ${I}/net/if.h ${I}/netinet/ip.h
tcp_usrreq.o: ${I}/netinet/ip_var.h ${I}/netinet/tcp.h
tcp_usrreq.o: ${I}/netinet/tcp_fsm.h ${I}/netinet/tcp_seq.h
tcp_usrreq.o: ${I}/netinet/tcp_timer.h ${I}/netinet/tcp_var.h
tcp_usrreq.o: ${I}/netinet/tcpip.h ${I}/netinet/tcp_debug.h ${I}/errno.h
	${C} ../net/tcp_usrreq.c
	${E} tcp_usrreq.s
	${A} tcp_usrreq.o tcp_usrreq.s
	rm -f tcp_usrreq.s

udp_usrreq.o: ../net/udp_usrreq.c
udp_usrreq.o: param.h ${I}/sys/dir.h ${I}/sys/user.h ${I}/sys/mbuf.h
udp_usrreq.o: ${I}/sys/protosw.h ${I}/sys/socket.h ${I}/sys/socketvar.h
