#
# make file for net objects
#

NET=	af.o if.o if_acc.o if_css.o if_dmc.o if_ec.o if_en.o if_ether.o \
	if_il.o if_imp.o if_imphost.o if_loop.o if_sri.o if_uba.o if_un.o \
	in.o in_pcb.o ip_icmp.o ip_input.o ip_output.o pup.o raw_cb.o \
	if_vv.o raw_imp.o raw_ip.o raw_pup.o raw_usrreq.o route.o tcp_debug.o \
	tcp_input.o tcp_output.o tcp_subr.o tcp_timer.o tcp_usrreq.o \
	udp_usrreq.o

# SPLFIX should be one of :splfix.movb, :splfix.mtps or :splfix.spl
SPLFIX=	:splfix.spl

I=	/usr/include
AS=	as ${OV}
DEFS=	-DKERNEL -Dpdp11
INC=	-I. -I${I}
CFLAGS=	-O ${OV} ${DEFS} ${INC}
CPP=	/lib/cpp -P ${DEFS} ${INC}
C=	${CC} ${CFLAGS} -S
E=	ed - < ${SPLFIX}
A=	${AS} - -o

all: ${NET}

# DO NOT DELETE THIS LINE
af.o: ../net/af.c
af.o: param.h ${I}/sys/mbuf.h ${I}/sys/protosw.h ${I}/sys/socket.h
af.o: ${I}/sys/socketvar.h ${I}/net/af.h
	${C} ../net/af.c
	${E} af.s
	${A} af.o af.s
	rm -f af.s

if.o: ../net/if.c
if.o: param.h ${I}/sys/systm.h ${I}/sys/socket.h ${I}/sys/protosw.h
if.o: ${I}/sys/ioctl.h ${I}/sys/dir.h ${I}/sys/user.h ${I}/errno.h
if.o: ${I}/netinet/in.h ${I}/netinet/in_systm.h ${I}/net/if.h
if.o: ${I}/net/af.h
	${C} ../net/if.c
	${E} if.s
	${A} if.o if.s
	rm -f if.s

if_acc.o: ../net/if_acc.c
if_acc.o: acc.h param.h ${I}/sys/systm.h ${I}/sys/mbuf.h ${I}/sys/buf.h
if_acc.o: ${I}/sys/protosw.h ${I}/sys/socket.h ${I}/sys/ubavar.h
