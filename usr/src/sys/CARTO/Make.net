udp_usrreq.o: ${I}/netinet/in_pcb.h ${I}/netinet/in_systm.h
udp_usrreq.o: ${I}/netinet/ip.h ${I}/netinet/ip_var.h
udp_usrreq.o: ${I}/netinet/ip_icmp.h ${I}/netinet/udp.h
	${C} ../net/udp_usrreq.c
	${E} udp_usrreq.s
	${A} udp_usrreq.o udp_usrreq.s
	rm -f udp_usrreq.s

