# make file for device objects

DEV=	bio.o cary.o cat.o dh.o dhdm.o dhfdm.o dkbad.o dkleave.o dn.o \
	dsort.o dvhp.o dz.o hk.o hp.o hs.o ht.o kl.o lp.o mem.o partab.o \
	tty_pty.o rf.o rk.o rl.o rm.o rp.o sys.o tm.o ts.o tty.o ttynew.o \
	ttyold.o vp.o xp.o dr.o

# SPLFIX should be one of :splfix.movb, :splfix.mtps or :splfix.spl
SPLFIX=	:splfix.spl

I=	/usr/include
AS=	as ${OV}
DEFS=	-DKERNEL -Dpdp11
INC=	-I. -I${I}
CFLAGS=	-O ${OV} ${DEFS} ${INC}
CPP=	/lib/cpp -P ${DEFS} ${INC}
C=	${CC} ${CFLAGS} -S
E=	ed - < ${SPLFIX}
A=	${AS} - -o

all: ${DEV}

# DO NOT DELETE THIS LINE
bio.o: ../dev/bio.c
bio.o: param.h ${I}/sys/systm.h ${I}/sys/dir.h ${I}/sys/user.h
bio.o: ${I}/sys/buf.h ${I}/sys/conf.h ${I}/sys/proc.h ${I}/sys/seg.h
bio.o: ${I}/sys/vm.h ${I}/sys/uba.h
	${C} ../dev/bio.c
	${E} bio.s
	${A} bio.o bio.s
	rm -f bio.s

cary.o: ../dev/cary.c
cary.o: param.h ${I}/sys/conf.h ${I}/sys/dir.h ${I}/sys/user.h
