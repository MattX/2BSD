#
# make file for optional objects
#

#
# Optional files
#
#OPT=	enable34.o bk.o cr.o dvhp.o rf.o

OPT=

# SPLFIX should be one of :splfix.movb, :splfix.mtps or :splfix.spl
SPLFIX=	:splfix.spl

I=	/usr/include
AS=	as ${OV}
DEFS=	-DKERNEL -Dpdp11
INC=	-I. -I${I}
CFLAGS=	-O ${OV} ${DEFS} ${INC}
CPP=	/lib/cpp -P ${DEFS} ${INC}
C=	${CC} ${CFLAGS} -S
E=	ed - < ${SPLFIX}
A=	${AS} - -o

all: ${OPT}

# DO NOT DELETE THIS LINE
	${C} 
	${E} 
	${A} 
	rm -f 

# DEPENDENCIES MUST END HERE
# IF YOU PUT STUFF HERE IT WILL GO AWAY
