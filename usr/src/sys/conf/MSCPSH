#  Machine configuration file.
#  Format:
#	name	value		comments
#
#  The value field may not contain blanks;
#  blank lines are not allowed.
#
#  Description file for 2.9BSD distributed kernel binary
#
#	General parameters
pdp11		73
ident		simh1173
maxusers	16
bootdev		ra
linefreq	50			# Europe 50 / USA 60
timezone	-1			# MET
dst		1
#
#	Filesystem configuration
rootdev		makedev(2,0)		# ra0a
swapdev		makedev(2,1)		# ra0b
dumpdev		NODEV
pipedev		makedev(2,0)		# ra0a
swplo		0
nswap		3200
dumplo		0
dumproutine	nodev
#
#	Device configuration
NXP		4		# at least 1 is required
NXP_CONTROLLER 	1
NHK		0
NRK		0
NRL		4
NRA		4		# total RA drives (RX50, RD51, RD52, RD53)
NRP		0
NHT		1		# required for other tape drivers
NTM		1
NTS		1		# TS11 / TSV05
NDZ		1		# in units of boards (8 each)
NDH		0		# in units of boards (16 each)
NDM		0		# in units of boards (16 each)
LOWDM		0		# LOWDM is in units of lines
NKL		6		# minimum 1 for the console
NLP		0
