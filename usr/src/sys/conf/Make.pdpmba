U=	../pdpmba
VPATH=	../pdpmba

CFILES=
OBJS=

.c.o:
	${CC} ${CFLAGS} -S $*.c
	${ED} - < SPLFIX $*.s
	${AS} - -o $*.o $*.s
	rm -f $*.s

all: ${OBJS}

depend: 
	mkdep -f Make.pdpmba ${CFLAGS} ${CFILES}

# DO NOT DELETE THIS LINE -- mkdep uses it.
# DO NOT PUT ANYTHING AFTER THIS LINE, IT WILL GO AWAY.

