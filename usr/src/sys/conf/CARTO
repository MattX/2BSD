#  Machine configuration file.
#  Format:
#	name	value		comments
#
#  The value field may not contain blanks;
#  blank lines are not allowed.
#
#  Description file for 2.9BSD distributed kernel binary
#
#	General parameters
pdp11		44
ident		CARTO
maxusers	7
bootdev		none
timezone	5			# Eastern
dst		1
#
#	Filesystem configuration
rootdev		makedev(6,0)		# xp0a
swapdev		makedev(6,1)		# xp0b
dumpdev		NODEV
pipedev		makedev(6,0)		# xp0a
swplo		0
nswap		3200
dumplo		0
dumproutine	nodev
#
#	Device configuration
NXP		1		# RM05
NXP_CONTROLLER	1		# RM05
NRL		1		# RL02
NTM		2		# Kennedy tape drive
NDZ		1		# in units of boards (8 each)
NDR		1		# DR-11W DMA device
NLP		1		# Line printer
NVV		1		# Proteon driver
NPTY		8		# pseudo-terminals
