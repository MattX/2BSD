#
# make file for system objects
#

CONF=	c.o ioconf.o

SYS=	acct.o alloc.o clock.o fio.o iget.o ioctl.o machdep.o main.o malloc.o \
	nami.o pipe.o prf.o prim.o rdwri.o sig.o slp.o subr.o sys1.o sys2.o \
	sys3.o sys4.o sysent.o syslocal.o text.o trap.o ureg.o ipc.o mbuf.o \
	mbuf11.o proto.o socket.o socketsubr.o

# SPLFIX should be one of :splfix.movb, :splfix.mtps or :splfix.spl
SPLFIX=	:splfix.spl

I=	/usr/include
AS=	as ${OV}
DEFS=	-DKERNEL -Dpdp11
INC=	-I. -I${I}
CFLAGS=	-O ${OV} ${DEFS} ${INC}
CPP=	/lib/cpp -P ${DEFS} ${INC}
C=	${CC} ${CFLAGS} -S
E=	ed - < ${SPLFIX}
A=	${AS} - -o

all: ${SYS} ${CONF} isr.o

isr.o:	../sys/isr.s
	${CPP} ${CPPFLAGS} ../sys/isr.s > isr.i
	${AS} -o isr.o isr.i
	-rm isr.i

# DO NOT DELETE THIS LINE
acct.o: ../sys/acct.c
acct.o: param.h ${I}/sys/systm.h ${I}/sys/acct.h ${I}/sys/dir.h
acct.o: ${I}/sys/user.h ${I}/sys/inode.h ${I}/sys/proc.h ${I}/sys/seg.h
	${C} ../sys/acct.c
	${E} acct.s
	${A} acct.o acct.s
	rm -f acct.s

alloc.o: ../sys/alloc.c
alloc.o: param.h ${I}/sys/systm.h ${I}/sys/filsys.h ${I}/sys/mount.h
alloc.o: ${I}/sys/fblk.h ${I}/sys/conf.h ${I}/sys/buf.h ${I}/sys/inode.h
alloc.o: ${I}/sys/ino.h ${I}/sys/dir.h ${I}/sys/user.h ${I}/sys/quota.h
	${C} ../sys/alloc.c
	${E} alloc.s
	${A} alloc.o alloc.s
	rm -f alloc.s

