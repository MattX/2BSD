rm -f Makefile
cp Makefile.dst Makefile
chmod u+w Makefile
ed - Makefile  <<'EOF'
/NEWSGRP/s/news/net/
/LIBDIR/c
LIBDIR = /usr/spool/news/lib
.
/BINDIR/c
BINDIR = /usr/bin
.
g/^#V7 /s/^#V7 //
g/^#USG /d
g/^#BSD4_1 /d
g/^#BSD4_2 /d
g/^VFORK/d
g/^SCCSID/d
g/CFLAGS =/s/$/ -Dvoid=int/
g/LFLAGS =/.t.-1
s/LFLAGS/LFLAGS2/
g/LFLAGS =/s/$/ -n/
g/LFLAGS2 =/s/$/ -i/
g/LIBS =/s/$/ -ljobs/
g/LNRNEWS =/s/ln/cp/
g/-o inews/s/LFLAGS/LFLAGS2/
g/-o inews/s/#NOTVMS//
g/-o readnews/s/LFLAGS/LFLAGS2/
g/-o vnews/s/LFLAGS/LFLAGS2/
g/-o expire/s/LFLAGS/LFLAGS2/
w
q
EOF
rm -f defs.h
cp defs.dist defs.h
chmod u+w defs.h
ed - defs.h <<'EOF'
/ROOTID/s/10/6/
/DOXREFS/s/^...//
/INTERNET/s/^...//
/NICENESS/s/^...//
/SENDMAIL/s/^...//
/GHNAME/s/^...//
/NICENESS/s/4/8/
/DFLTEXP/s/2/4/
/HISTEXP/s/4/6/
/DFLTSUB/s/general/general,all.general,duke.physics,duke.math/
/DFTXMIT/s/uux/uux -gd/
/UXMIT/s/uux/uux -gd/
/N_UMASK/s/000/022/
/MYORG/c
#define MYORG	"Duke University Physics Dept.; Durham, N.C."
.
w
q
EOF
